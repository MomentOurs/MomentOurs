<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="beyond.momentours.randomquestion.query.repository.RandomQuestionMapper">
    <resultMap id="userRandomQuestionResultMap" type="beyond.momentours.randomquestion.query.dto.UserRandomQuestionDTO">
        <id property="userQuesId" column="user_ques_id"/>
        <result property="ansStatus" column="ans_status"/>
        <result property="createdAt" column="created_at"/>
        <result property="used" column="used"/>
        <result property="coupleId" column="couple_id"/>
        <result property="quesId" column="ques_id"/>
    </resultMap>

    <resultMap id="randomQuestionResultMap" type="beyond.momentours.randomquestion.query.dto.RandomQuestionDTO">
        <id property="quesId" column="ques_id"/>
        <result property="quesContent" column="ques_content"/>
    </resultMap>

    <select id="getRandomQuestionByMemberId" resultMap="userRandomQuestionResultMap" parameterType="long">
        SELECT user_ques_id
             , ans_status
             , created_at
             , couple_id
          FROM tb_user_random_question
         WHERE couple_id = (
        SELECT couple_id
          FROM TB_COUPLE_LIST
         WHERE member_id1 = #{memberId}
            OR member_id2 = #{memberId}
        )
    </select>

    <select id="getRandomQuestionByQuesId" resultMap="userRandomQuestionResultMap">
        SELECT user_ques_id
             , ans_status
             , created_at
             , couple_id
          FROM tb_user_random_question
         WHERE couple_id = (
        SELECT couple_id
          FROM TB_COUPLE_LIST
         WHERE member_id1 = #{memberId}
            OR member_id2 = #{memberId}
        )
           AND user_ques_id = #{userQuesIdx}
    </select>
    
    <!-- 모든 질문 조회 -->
    <select id="findAllQuestions" resultMap="randomQuestionResultMap">
        SELECT
               a.ques_id
             , a.ques_content
          FROM tb_random_question a
    </select>
    
    <!-- 특정 커플이 사용한 질문 목록 조회 -->
    <select id="findUsedQuestionsByCoupleId" resultType="Long">
        SELECT
               a.ques_id
          FROM tb_user_random_question a
         WHERE a.couple_id = #{coupleId}
    </select>

</mapper>