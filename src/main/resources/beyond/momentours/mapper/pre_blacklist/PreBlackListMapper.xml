<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="beyond.momentours.pre_blacklist.query.repository.PreBlackListMapper">
    <resultMap id="preBlacklistMap" type="beyond.momentours.pre_blacklist.query.dto.PreBlackListDTO">
        <id property="preBlackId" column="pre_black_id"/>
        <result property="blackListCount" column="black_list_count"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="memberId" column="member_id"/>

        <association property="member" javaType="beyond.momentours.member.query.dto.MemberDTO">
            <id property="memberId" column="member_id"/>
            <result property="memberName" column="member_name"/>
        </association>
    </resultMap>

    <select id="findByPreBlacklistAll" resultMap="preBlacklistMap">
        SELECT DISTINCT
        a.black_list_count,
        a.status,
        a.created_at,
        a.pre_black_id,
        b.member_name
        FROM pre_black_list a
        JOIN tb_member b ON a.member_id = b.member_id
    </select>

    <select id="findReportsByPreBlackListId" resultType="beyond.momentours.report.command.application.dto.ReportDTO">
        SELECT r.report_id, r.report_type, r.report_reason, r.process_status, r.target_id, r.created_at, r.reported_user_id, r.report_user_id
          FROM report r
         WHERE r.pre_black_id = #{preBlackListId}
    </select>
</mapper>