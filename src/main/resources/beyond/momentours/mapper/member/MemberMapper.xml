<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="beyond.momentours.member.query.repository.MemberMapper">
    <resultMap id="memberResultMap" type="beyond.momentours.member.query.dto.MemberDTO">
        <id property="memberId" column="member_id"/>
        <result property="memberEmail" column="member_email"/>
        <result property="memberPassword" column="member_password"/>
        <result property="memberName" column="member_name"/>
        <result property="memberNickname" column="member_nickname"/>
        <result property="memberPhone" column="member_phone"/>
        <result property="memberBirth" column="member_birth"/>
        <result property="memberGender" column="member_gender"/>
        <result property="memberMbti" column="member_mbti"/>
        <result property="memberRole" column="member_role"/>
        <result property="memberStatus" column="member_status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByMemberId" resultType="Long" parameterType="Long">
        SELECT
                a.member_id
        FROM tb_member a
        WHERE a.member_id = #{memberId}
        AND a.member_status = 1;
    </select>

    <select id="findByMemberEmail" resultType="string" parameterType="string">
        SELECT
               a.member_email
          FROM tb_member a
         WHERE a.member_email = #{memberEmail}
        AND a.member_status = 1;
    </select>

    <select id="findMemberEmailByMypage" resultMap="memberResultMap" parameterType="Long">
        SELECT
               a.member_email,
               a.member_nickname,
               a.member_name,
               a.member_phone,
               a.member_birth,
               a.member_gender,
               a.member_mbti
        FROM tb_member a
        WHERE a.member_id = #{memberId}
        AND a.member_status = 1;
    </select>

    <select id="findMemberSearch" resultMap="memberResultMap">
        SELECT
               a.member_email,
               a.member_nickname
          FROM tb_member a
         WHERE
            <trim prefixOverrides="AND">
                <if test="memberNickname != null and memberNickname != ''">
                    AND a.member_nickname LIKE CONCAT('%', #{memberNickname}, '%')
                </if>
                <if test="memberEmail != null and memberEmail != ''">
                    AND a.member_email LIKE CONCAT('%', #{memberEmail}, '%')
                </if>
            </trim>
    </select>

</mapper>