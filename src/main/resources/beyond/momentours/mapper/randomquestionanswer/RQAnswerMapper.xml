<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="beyond.momentours.randomquestionanswer.query.repository.RQAnswerMapper">
    <resultMap id="rqAnswerMap" type="beyond.momentours.randomquestionanswer.query.dto.RQAnswerDTO">
        <id property="quesAnswerId" column="ques_ans_id"/>
        <result property="quesAnsContent" column="ques_ans_content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="userQuesId" column="user_ques_id"/>
        <result property="memberId" column="member_id"/>
    </resultMap>

    <select id="findByQuesAnswerIdAndMemberId" resultMap="rqAnswerMap">
        SELECT
             , a.ques_ans_id
             , ques_ans_content
             , created_at
             , updated_at
             , user_ques_id
             , member_id
          FROM tb_ques_answer a
         WHERE a.ques_ans_id = #{quesAnswerId}
           AND a.member_id = #{memberId}
    </select>
</mapper>